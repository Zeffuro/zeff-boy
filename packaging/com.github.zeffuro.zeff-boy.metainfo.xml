<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.zeffuro.zeff-boy</id>
  <name>zeff-boy</name>
  <summary>A Game Boy, NES, WonderSwan, and Sega 8-bit emulator</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>

  <description>
    <p>
      zeff-boy is a Game Boy, Game Boy Advance, NES, WonderSwan, and Sega 8-bit emulator written in Rust.
      It features save states, cheats, a libretro core,
      and runs on Windows, macOS, Linux, and the web.
    </p>
  </description>

  <launchable type="desktop-id">zeff-boy.desktop</launchable>

  <url type="homepage">https://github.com/Zeffuro/zeff-boy</url>
  <url type="bugtracker">https://github.com/Zeffuro/zeff-boy/issues</url>
  <url type="vcs-browser">https://github.com/Zeffuro/zeff-boy</url>

  <developer id="com.github.zeffuro">
    <name>Zeffuro</name>
  </developer>

  <provides>
    <binary>zeff-boy</binary>
  </provides>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.2.0" date="2026-08-20">
      <description>
        <p>Adds Game Boy Advance, WonderSwan, Sega 8-bit, firmware management, and updater support.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-04-08">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>

